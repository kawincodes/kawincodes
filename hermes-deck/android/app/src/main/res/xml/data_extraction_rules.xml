<?xml version="1.0" encoding="utf-8"?>
<!-- Vault entries are encrypted with a device-bound Keystore key; backing them up is useless and leaks metadata. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
